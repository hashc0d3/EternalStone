# Copy to .env (production) or apps/api/.env and apps/web/.env.local (local dev)

POSTGRES_USER=eternal
POSTGRES_PASSWORD=eternal
POSTGRES_DB=eternal_stone
POSTGRES_PORT=5432

DATABASE_URL=postgresql://eternal:eternal@localhost:5432/eternal_stone?schema=public

API_PORT=4000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

SESSION_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@eternal-stone.local
ADMIN_PASSWORD=changeme

# Production Docker (docker compose up --build)
# Public port, change if 80 is busy: PORT=8080
PORT=80
SITE_URL=http://localhost
COOKIE_SECURE=false
RUN_SEED=true
